# =============================================================================
# PREPZO AI FRONTEND - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase project URL and keys
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# =============================================================================
# BACKEND API ENDPOINTS
# =============================================================================
# Main backend URL for user portal API
# This is used for subscription, profile, and tool operations
NEXT_PUBLIC_BACKEND_URL_USER_PORTAL=https://your-backend-api.com

# Legacy backend URL (used in some components)
NEXT_PUBLIC_BACKEND_URL=https://your-legacy-backend-api.com

# =============================================================================
# STRIPE PAYMENT CONFIGURATION
# =============================================================================
# Stripe publishable key for client-side payments (if needed for direct integration)
# Get this from your Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Stripe Price IDs for subscription plans
# Get these from your Stripe dashboard under Products
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_your_premium_monthly_price_id

# =============================================================================
# LIVEKIT CONFIGURATION
# =============================================================================
# LiveKit configuration for video/audio features (mock interviews)
# These are exposed via next.config.js
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-server.com

# =============================================================================
# AMPLITUDE ANALYTICS
# =============================================================================
# Amplitude API key for user analytics
# Can be used on both client and server side
AMPLITUDE_API_KEY=your-amplitude-api-key
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# =============================================================================
# ADDITIONAL API ENDPOINTS
# =============================================================================
# Summary API for interview session summaries
NEXT_PUBLIC_SUMMARY_API_URL=https://your-summary-api.com

# Connection details endpoint (defaults to /api/connection-details if not set)
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=/api/connection-details

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
# Automatically set by Next.js, but can be overridden
# Values: development, production, test
NODE_ENV=development

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# These are automatically handled by Next.js but documented for reference
# NEXT_PUBLIC_VERCEL_URL=your-vercel-deployment-url
# VERCEL=1 (automatically set on Vercel deployments)

# =============================================================================
# NOTES
# =============================================================================
# 1. All NEXT_PUBLIC_ variables are exposed to the browser
# 2. Variables without NEXT_PUBLIC_ are only available on the server
# 3. Never put sensitive keys in NEXT_PUBLIC_ variables
# 4. The service role key should only be used server-side
# 5. Make sure to use the correct environment (test/live) for Stripe keys
